# Copiar a /etc/atalaya/agente.env (chmod 600). NUNCA subir este archivo con valores reales a GitHub.
# Backend por el peering (IP privada de ec2-backend)
ATALAYA_BACKEND_URL=http://10.0.128.10:3000
# La misma IDS_INGEST_KEY del .env del backend (npm run setup la imprime)
ATALAYA_INGEST_KEY=
# Token que da @BotFather (/newbot) y chat_id del grupo (número negativo, p. ej. -100xxxxxxxxxx)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Archivo de Suricata y rango de SID de nuestras reglas locales
SURICATA_EVE=/var/log/suricata/eve.json
SURICATA_SID_MIN=1100000
SURICATA_SID_MAX=1199999
# Agrupa alertas iguales (mismo sensor, SID y origen) durante N segundos para no saturar el grupo
TELEGRAM_COOLDOWN_SECONDS=20
POLL_SECONDS=2
# Accesos al sitio que se publican en el grupo (auditoría de la API). Quita los que no quieras.
TELEGRAM_AUDIT_TYPES=LOGIN_SUCCESS,LOGIN_FAILURE,LOGOUT,ACCESS_DENIED,SERVICE_KEY_REJECTED,IDS_RESET
