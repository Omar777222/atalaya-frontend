# Atalaya · Reglas de Suricata (NIDS en ec2-frontend) · atalaya-obj3-nmap.rules
# Copiar a /var/lib/suricata/rules/ y agregar en rule-files de suricata.yaml · SID 1100001 a 1100299
# Generado con npm run rules:export: edita atalaya-backend/src/domain/catalog/detectionCatalog.js

# ===== Objetivo 3 · Escaneo con Nmap =====
# Tráfico: nmap -sS desde Kali contra la IP pública del frontend.
# Por qué: Muchos SYN desde una sola IP en 5 s. flags:S,12 ignora los bits ECN para que la regla no falle con pilas TCP modernas.
alert tcp any any -> $HOME_NET any (msg:"ATALAYA SURICATA Escaneo SYN (nmap)"; flags:S,12; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1100002; rev:1;)

# Tráfico: nmap -sV -sC -p 80: los scripts NSE hacen peticiones HTTP con su propio User-Agent.
# Por qué: NSE se anuncia como "Mozilla/5.0 (compatible; Nmap Scripting Engine)" en http.user_agent.
alert http any any -> $HOME_NET any (msg:"ATALAYA SURICATA Nmap Scripting Engine"; flow:to_server,established; http.user_agent; content:"Nmap Scripting Engine"; nocase; classtype:web-application-attack; sid:1100003; rev:1;)
